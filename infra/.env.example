# Variáveis do docker-compose.yml (infra/) — Postgres, Grafana e SSO
# na VM (vm-itp-prod). Copie para ".env" na MESMA pasta onde o
# docker-compose.yml roda de verdade (~/itp-stack/ na VM) e preencha com
# os valores reais. NUNCA commitar o .env preenchido.
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui
GRAFANA_ADMIN_PASSWORD=defina_uma_senha_forte_aqui
# SSO Microsoft do Grafana reaproveita o mesmo app registration do erp_itp
# (MS_CLIENT_ID/MS_CLIENT_SECRET/MS_TENANT_ID) — copie os mesmos valores
# de erp_itp_backend.env pra cá, não são credenciais novas.
MS_CLIENT_ID=copie_do_erp_itp_backend.env
MS_CLIENT_SECRET=copie_do_erp_itp_backend.env
MS_TENANT_ID=copie_do_erp_itp_backend.env
